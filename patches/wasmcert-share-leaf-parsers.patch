+(* ---------------------------------------------------------------------
+   The instruction parsers below take the leaf parsers they use as
+   parameters rather than re-elaborating them.  A parseque parser is
+   indexed by the remaining input size, so every *reference* to a parser
+   rebuilds it: with the leaves inlined at each use site, parsing a single
+   instruction rebuilt parse_u32_as_N ~190 times, which dominated parsing
+   (15.6M parser constructions for 175KB of input, against 3.8M token
+   reads).  Taking them as section variables means the grammar builds each
+   one once per index, where [language] below binds them with [let].
+   ------------------------------------------------------------------- *)
+Section instrs.
+
+Context {n : nat}.
+Variable p_u32 : byte_parser N n.
+Variable p_u8 : byte_parser N n.
+Variable p_s32 : byte_parser Wasm_int.Int32.int n.
+Variable p_s64 : byte_parser Wasm_int.Int64.int n.
+Variable p_valtype : byte_parser value_type n.
+Variable p_memarg : byte_parser memarg n.
+
+Definition assert_u32_shared (k : N) : byte_parser N n :=
+  guardM (fun parsed_n => if N.eqb parsed_n k then Some k else None) p_u32.
+
+Definition parse_unreachable : byte_parser basic_instruction n :=
   exact_byte x00 $> BI_unreachable.
 
